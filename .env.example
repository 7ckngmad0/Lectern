# Copy to .env.local (gitignored) and fill in from Supabase → Project Settings → API.
# Leave empty to run the app in demo mode on mock data.
#
# Only the PUBLISHABLE key (or legacy "anon" key) goes here. It is safe in the app
# because Row Level Security protects the data. NEVER put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
